{
  "name": "automated-devsecops-security-pipeline",
  "version": "0.1.0",
  "description": "An automated DevSecOps security pipeline for continuous vulnerability detection and secure deployment of web applications.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "node --check src/server.js && node --check test/server.test.js"
  },
  "keywords": [
    "application-security",
    "devsecops",
    "owasp",
    "sast",
    "dast",
    "supply-chain-security"
  ],
  "author": "Tarun Yadav",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "pino": "^9.3.2",
    "zod": "^4.5.4"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
